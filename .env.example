# ---- Copy this file to ".env" for local development ----

# Port the server listens on (Render sets this automatically in production)
PORT=3000

# Admin portal password. CHANGE THIS to something strong before going live.
ADMIN_PASSWORD=changeme123

# Secret used to sign admin login sessions. Set to a long random string in production.
SESSION_SECRET=please-change-this-to-a-long-random-string

# Database location.
# Local development: leave blank to use a local SQLite file at ./data/booking.db
# Production (Render): set these to your free Turso database (see README "Going Live").
DATABASE_URL=
DATABASE_AUTH_TOKEN=
