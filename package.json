{
  "name": "dental-clinic-manager",
  "version": "0.1.0",
  "description": "Desktop application for dental clinic patient management, consent forms, tooth charting and treatment reporting",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "start": "npm run electron:dev"
  },
  "keywords": ["dental", "clinic", "patient-management", "electron", "react"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "jspdf": "^2.5.2",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "signature_pad": "^5.0.4",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
